# Copy to .env (which is gitignored). NEVER commit real keys.

# --- Agnes (AI summarization, OpenAI-compatible chat) ---
# Reuse the same key your merch-canvas backend uses, but set it HERE, not in source.
# (Reminder: rotate the key currently hardcoded in merch-canvas/backend/app/config.py:8.)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com

# --- Telegram delivery (Slice-0 default channel) ---
# 1. In Telegram, message @BotFather -> /newbot -> copy the bot token.
# 2. Open a chat with your new bot and send it any message (required!).
# 3. Get your chat_id:
#    curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" \
#      | python -c "import sys,json;print(json.load(sys.stdin)['result'][-1]['message']['chat']['id'])"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
